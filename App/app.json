{
  "expo": {
    "name": "OTOCH",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F4075",
          "image": "./assets/splash/splash-mark@3x.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F4075",
            "image": "./assets/splash/splash-mark@3x.png"
          },
          "ios": {
            "backgroundColor": "#0F4075",
            "image": "./assets/splash/splash-logo@3x.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#0F4075",
              "image": "./assets/splash/splash-logo@3x.png"
            }
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Өөрийн аватар болон эмчийн заалтын зургийг сонгоход зургийн сан руу хандах шаардлагатай.",
          "cameraPermission": "Эмчийн заалтын зургийг авахад камер ашиглах шаардлагатай.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
