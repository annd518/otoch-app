# Copy to .env.local for local development. Never commit real values.
# EXPO_PUBLIC_* values are inlined into the app bundle, so never put secrets here.

# Server root URL without /api. Required for release builds and must be https://.
# Leave empty in development to use the Metro host LAN IP (or 10.0.2.2 / localhost).
EXPO_PUBLIC_API_URL=

# Port for the development fallback when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_API_PORT=8000

# real (default) or mock. Mock is honoured only in development builds.
# With "mock" and no EXPO_PUBLIC_MOCK_ENDPOINTS, every mockable endpoint is mocked.
EXPO_PUBLIC_API_MODE=real

# Development only: mock exactly these endpoints (catalog, orders, redFlags, attachments).
# Example while the backend has catalog but not orders:
# EXPO_PUBLIC_MOCK_ENDPOINTS=orders,redFlags,attachments
EXPO_PUBLIC_MOCK_ENDPOINTS=

# Development only, comma separated mock scenarios:
# empty | error (catalog), order-network-error-once, redflag-load-error,
# redflag-submit-error, upload-fail-once
EXPO_PUBLIC_MOCK_SCENARIO=

# Approved public legal pages (HTTPS); never put credentials here.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
