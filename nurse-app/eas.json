{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true
    }
  }
}
