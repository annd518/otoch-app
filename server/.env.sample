# Copy to .env and fill in. Never commit real values.

DATABASE_URL="your postgresql db url (UTF8 database)"
JWT_SECRET="long random secret (>= 32 chars)"
JWT_EXPIRES_IN="7d"

NODE_ENV="development"
PORT=8000
# Public HTTPS origin of this API (used to build the QPay callback URL in sandbox)
PUBLIC_BASE_URL=""

# Production only: comma-separated allowed browser origins (mobile apps don't need CORS)
CORS_ORIGINS=""
# Behind a reverse proxy / load balancer: number of proxy hops, e.g. "1" on Render.
# Needed so OTP rate limits see real client IPs. Do not use "true".
TRUST_PROXY=""

# Development only: "true" logs every SQL query (may include patient data). Never in production.
PRISMA_LOG_QUERIES="false"

# Private referral image storage: "local-dev" (development only, ./.local-uploads) or
# "s3" (private S3-compatible bucket, S3_* below; e.g. Cloudflare R2). Empty = "local-dev"
# when NODE_ENV=development, otherwise no storage (uploads answer 503 STORAGE_UNAVAILABLE).
STORAGE_DRIVER=""

# NODE_ENV=production refuses quotes/payments/seed on fixture (unapproved) prices and red flag
# questions. "true" only for a staging that knowingly runs on fixtures. Never for real customers.
ALLOW_FIXTURE_DATA="false"

# QPay: "mock" (fake, not QPay) or "sandbox" (QPay merchant sandbox). Production is disabled.
QPAY_MODE="mock"
QPAY_BASE_URL=""
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_CALLBACK_SECRET=""

# for sending mails . get these from gmail
EMAIL_USER="your email for sending mails"
EMAIL_PASS="app password for email"

# v2 phone auth. Real delivery is a HTTPS webhook contract: {to,message}.
SMS_DRIVER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Development only; production always ignores both mock options.
EXPOSE_TEST_OTP=
# Fixed-code numbers for store review / staging testers who cannot receive SMS:
# "+976XXXXXXXX:NNNNNN,..." (no SMS is sent to them; trivial codes like 123456 are ignored).
# Keep it empty unless needed; the codes are secrets.
OTP_TEST_ACCOUNTS=

# Isolated synthetic-data test deployment only
APP_ENV=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
