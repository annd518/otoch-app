generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHILD
  NURSE
  MEDICAL_ADMIN
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role
  phone          String? @unique
  deletedAt      DateTime?
  refreshSessions RefreshSession[]
  pushDevices     PushDevice[]
  assignedOrders Order[] @relation("AssignedOrderNurse")
  nurseProfile   NurseProfile?
  orderOffers    OrderOffer[]
  ratingsReceived NurseRating[] @relation("NurseRatings")
  parents        Parent[] @relation("ChildParents")
  nurseVisits    Visit[]  @relation("NurseVisits")
  approvedVisits Visit[]  @relation("ApprovedBy")
  orders         Order[]  @relation("ChildOrders")
  createdAt      DateTime @default(now())
}

model Parent {
  id               String  @id @default(cuid())
  name             String
  birthYear        Int?
  needsRepresentative Boolean @default(false)
  age              Int
  gender           String
  address          String
  diseases         String?
  medications      String?
  emergencyContact String
  children         User[]  @relation("ChildParents")
  visits           Visit[]
  orders           Order[]
}

model Visit {
  id            String      @id @default(cuid())
  parentId      String
  nurseId       String?
  scheduledFor  DateTime
  visitType     VisitType
  status        VisitStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?
  vitals        Vitals?
  Parent        Parent      @relation(fields: [parentId], references: [id])
  Nurse         User?       @relation("NurseVisits", fields: [nurseId], references: [id])
  approvedById  String?
  ApprovedBy    User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvalNote  String?
  rejectionNote String?
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
}

model Vitals {
  id          String   @id @default(cuid())
  visitId     String   @unique
  bp          String?
  sugar       String?
  pulse       String?
  oxygen      String?
  temperature String?
  notes       String?
  medicines   String?
  Visit       Visit    @relation(fields: [visitId], references: [id])
  createdAt   DateTime @default(now())
}

enum VisitStatus {
  PENDING
  ASSIGNED
  STARTED
  WAITING_APPROVAL
  REVISION_REQUIRED
  APPROVED
  COMPLETED
}

enum VisitType {
  BASIC
  FULL
}

// ---- L1-1: service catalog (additive; no relations to existing models yet) ----
model ServiceCatalogItem {
  id               String      @id @default(cuid())
  code             String      @unique // stable machine code, e.g. HOME_BASIC_CHECK
  name             String
  description      String?
  category         String
  priceMnt         Int // integer MNT, display only — final price comes from the server quote
  durationMin      Int
  requiresReferral Boolean     @default(false)
  questionnaire    String? // red flag questionnaire code, e.g. GENERAL_V1
  isActive         Boolean     @default(true)
  isFixture        Boolean     @default(false) // true = fictional test data, not an approved service/price
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  metadata         Json?
  contentVersion   String?
  approvedBy       String?
  approvedAt       DateTime?
  orderItems       OrderItem[]

  @@index([isActive, category, sortOrder])
}

// ---- L1-1: draft orders + red flag (PROPOSED: separate Order model, docs/l1-1-api.md D2) ----
// Additive only. Existing Visit flow is untouched; an Order will create a Visit after payment (not implemented).
enum OrderStatus {
  DRAFT
  BLOCKED_RED_FLAG
  AWAITING_PAYMENT
  PAID
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  REFUSED
  INCIDENT
  NO_SHOW // the nurse came, nobody was there (spec slide 25: no refund)
  CANCELLED
  EXPIRED
}

enum RedFlagStatus {
  NOT_ANSWERED
  CLEAR
  FLAGGED
}

model Order {
  id                String        @id @default(cuid())
  childId           String
  parentId          String
  status            OrderStatus   @default(DRAFT)
  version           Int           @default(1) // optimistic locking for PATCH
  catalogVersion    String // catalog version the server validated the items against
  scheduledFor      DateTime?
  timeSlot          String?
  bookingForm       Json?
  zoneId            String?
  assignedNurseId   String?
  eta               DateTime?
  addressText       String?
  lat               Float?
  lng               Float?
  notes             String?
  redFlagStatus     RedFlagStatus @default(NOT_ANSWERED)
  redFlagAnsweredAt DateTime?
  // Cancellation (spec slide 25): who (CLIENT | ADMIN | SYSTEM), when and why
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedNurse User? @relation("AssignedOrderNurse", fields: [assignedNurseId], references: [id])
  child          User            @relation("ChildOrders", fields: [childId], references: [id])
  parent         Parent          @relation(fields: [parentId], references: [id])
  items          OrderItem[]
  redFlagAnswers RedFlagAnswer[]
  events         OrderEvent[]
  quotes         Quote[]
  attachments    Attachment[]
  payments       Payment[]
  visitRecord    VisitRecord?
  refunds        Refund[]
  offers         OrderOffer[]
  rating         NurseRating?

  @@index([childId, status])
}

enum NurseStatus {
  PENDING // an application: not sent yet (submittedAt null) or waiting for an admin
  VERIFIED
  SUSPENDED
  REJECTED // the nurse fixes the application (reviewNote) and sends it again
}

// What an admin verified about a nurse (spec slide 35). Only a VERIFIED nurse with a
// valid licence, the needed skills and isActive = true is offered orders.
model NurseProfile {
  userId           String      @id
  status           NurseStatus @default(PENDING)
  licenseNo        String?
  licenseExpiresAt DateTime?
  skillTags        String[] // INJ, IV, WOUND, CATH, NG, CARE
  zoneIds          String[] // empty = every zone
  // Ulaanbaatar districts the nurse works in (Баянгол, ...). Offers come only
  // from these; empty = every district (nurses registered before districts).
  districts        String[]    @default([])
  isActive         Boolean     @default(false) // the nurse's own "online" toggle
  // Application the nurse sends from the nurse app (spec N-01, slide 35)
  employer         String?
  experienceYears  Int?
  submittedAt      DateTime?
  // Admin's decision (spec A-01). reviewNote is the reason shown to the nurse.
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents NurseDocument[]
  reviews   NurseReviewEvent[]
}

enum NurseDocumentKind {
  LICENSE // professional licence
  DIPLOMA
  ID_CARD
  PORTRAIT
}

// One private image per kind; a new upload replaces the old one. Read only by
// the nurse and an admin through the API (never a public URL).
model NurseDocument {
  id            String            @id @default(cuid())
  nurseId       String
  kind          NurseDocumentKind
  storageDriver String
  storageKey    String            @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  createdAt     DateTime          @default(now())

  nurse NurseProfile @relation(fields: [nurseId], references: [userId], onDelete: Cascade)

  @@unique([nurseId, kind])
}

// Audit trail of an application: SUBMITTED, APPROVED, REJECTED, SUSPENDED.
model NurseReviewEvent {
  id        String   @id @default(cuid())
  nurseId   String
  actorId   String
  action    String
  note      String?
  createdAt DateTime @default(now())

  nurse NurseProfile @relation(fields: [nurseId], references: [userId], onDelete: Cascade)

  @@index([nurseId, createdAt])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// One order offered to one nurse in one dispatch wave (spec slide 70).
model OrderOffer {
  id          String      @id @default(cuid())
  orderId     String
  nurseId     String
  wave        Int
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  nurse User  @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([orderId, nurseId])
  @@index([nurseId, status, expiresAt])
  @@index([orderId, status])
}

// Nurse's record of one home visit (spec slides 34-36, A/41 appendix 3).
// One per order. Check-in fields are written by POST .../checkin, the rest by the
// autosaved PUT .../record; signing it (POST .../finish) completes the order.
model VisitRecord {
  id               String    @id @default(cuid())
  orderId          String    @unique
  nurseId          String
  checkinAt        DateTime?
  checkinMethod    String?
  checkinLat       Float?
  checkinLng       Float?
  checkinDistanceM Int?
  checklist        Json? // { identified, hygiene, medicationChecked } confirmed at check-in
  vitals           Json? // { systolic, diastolic, pulse, temperatureC, spo2 }
  procedures       Json? // string[] of performed procedure codes
  medicationChecks Json? // { patient, medicine, dose, route, time } 5 rights
  note             String?
  signerName       String?
  signature        String? // PNG data URL drawn on screen
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  serviceId   String
  serviceCode String // snapshot of the stable catalog code
  quantity    Int    @default(1)

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  @@unique([orderId, serviceCode])
}

// Questionnaire codes are versioned identifiers (e.g. GENERAL_V1); a new text = a new code.
model RedFlagQuestion {
  id            String  @id @default(cuid())
  questionnaire String
  code          String
  text          String
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  isFixture     Boolean @default(false) // true = placeholder text, not approved clinical content

  approvedBy String?
  approvedAt DateTime?
  answers RedFlagAnswer[]

  @@unique([questionnaire, code])
}

model RedFlagAnswer {
  id         String   @id @default(cuid())
  orderId    String
  questionId String
  value      Boolean
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  question RedFlagQuestion @relation(fields: [questionId], references: [id])

  @@unique([orderId, questionId])
}

// Audit trail. metadata must never contain health details (e.g. which red flag answer was "yes").
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  type       String
  fromStatus String?
  toStatus   String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ---- L1-1 (10.14): idempotency, quote, private attachments, payments ----

// Stores the outcome of a request made with an Idempotency-Key, scoped per user + operation.
// The unique constraint makes concurrent duplicates collapse to one resource.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  scope        String // e.g. "orders.create", "attachments.create:<orderId>", "payments.create:<orderId>"
  key          String
  requestHash  String // sha256 of the canonical request payload
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

// Server-computed price snapshot. Valid only for the exact order version and catalog version.
// A quote is NOT a payment and does not confirm the order.
model Quote {
  id             String   @id @default(cuid())
  orderId        String
  orderVersion   Int
  catalogVersion String
  pricingVersion String
  currency       String   @default("MNT")
  lines          Json
  subtotalMnt    Int
  totalMnt       Int
  isFixture      Boolean // true when any priced service is fixture data
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([orderId, createdAt])
}

enum AttachmentStatus {
  ACTIVE
  DELETED
}

// Private file metadata. The blob lives in private storage under a random key; never under /uploads.
model Attachment {
  id            String           @id @default(cuid())
  orderId       String
  uploaderId    String
  kind          String           @default("REFERRAL")
  storageDriver String // memory | local-dev | s3
  storageKey    String           @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  status        AttachmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  quoteId           String
  userId            String
  provider          String        @default("QPAY")
  mode              String // mock | sandbox (production disabled)
  idempotencyKey    String
  amountMnt         Int
  currency          String        @default("MNT")
  status            PaymentStatus @default(PENDING)
  providerInvoiceId String?       @unique
  providerPaymentId String?       @unique
  qrText            String?
  qrImage           String?
  deeplinks         Json?
  expiresAt         DateTime
  paidAt            DateTime?
  lastCheckedAt     DateTime?
  failureCode       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  quote   Quote    @relation(fields: [quoteId], references: [id])
  refunds Refund[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId, status])
}

// v2 additions: old patients/orders remain unknown until explicitly supplied.
model RefreshSession {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id])
}
model OtpChallenge {
  id String @id @default(cuid())
  phone String
  ipHash String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  lockedUntil DateTime?
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}
model ServiceZone {
  id String @id
  name String
  isActive Boolean @default(true)
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float
  slots AvailabilitySlot[]
}
model AvailabilitySlot {
  id String @id @default(cuid())
  zoneId String
  startsAt DateTime
  endsAt DateTime
  capacity Int
  zone ServiceZone @relation(fields: [zoneId], references: [id])
  @@unique([zoneId, startsAt])
}
model AccountDeletionRequest {
  id String @id @default(cuid())
  userId String @unique
  requestedAt DateTime @default(now())
  status String @default("REQUESTED")
}

model ContentPublication {
  id String @id @default(cuid())
  kind String
  version String
  digest String
  payload Json
  approvedBy String
  approvedAt DateTime
  createdAt DateTime @default(now())
  @@unique([kind, version])
}
model BlobCleanupJob {
  id String @id @default(cuid())
  storageKey String @unique
  storageDriver String
  attempts Int @default(0)
  completedAt DateTime?
  createdAt DateTime @default(now())
}

// A phone that receives push notifications (Expo push token). One token belongs
// to the account last signed in on that phone; it is removed on sign-out or
// when Expo reports it is no longer registered.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  app        String // client | nurse
  platform   String // ios | android
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app])
}

enum RefundStatus {
  PENDING // being sent to QPay
  REFUNDED // QPay confirmed, or an admin refunded by hand
  MANUAL_REQUIRED // QPay refused or cannot do it (e.g. a partial refund): an admin refunds by hand
}

// Money going back to the customer after a cancellation (spec slide 25).
model Refund {
  id            String       @id @default(cuid())
  orderId       String
  paymentId     String
  percent       Int // of the paid amount
  amountMnt     Int
  status        RefundStatus @default(PENDING)
  failureCode   String?
  requestedById String
  resolvedById  String? // admin who refunded by hand
  resolvedNote  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
}

// The customer's rating of a finished visit (spec SCR-C16): 1-5 stars, optional
// tags and comment. One per order; it cannot be changed afterwards.
model NurseRating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  nurseId   String
  clientId  String
  stars     Int // 1-5
  tags      String[] @default([]) // ON_TIME, KIND, PROFESSIONAL
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  nurse User  @relation("NurseRatings", fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, createdAt])
}
